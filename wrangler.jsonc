{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ec-builder",
  "compatibility_date": "2026-09-20",
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "AI_IP_RATE_LIMIT",
      "namespace_id": "26101",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "AI_GLOBAL_RATE_LIMIT",
      "namespace_id": "26102",
      "simple": { "limit": 80, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
